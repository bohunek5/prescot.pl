				<div class="elementor-element elementor-element-37de1c26 elementor-widget elementor-widget-html" data-id="37de1c26" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<style>
.dm-card-slider{
    --radius: 15px;
    --active-height: 550px;
    --height: 450px;
    --mobile-height: 300px;
    --overlay: 0.75;
}

/* Stylowanie tylko konkretnych slajdów, nie całego kontenera */
.dm-card-slider .swiper-slide{
    display: flex;
    align-items: flex-end;
    border-radius: var(--radius);
    height: var(--height);
    transition: 0.5s;
    position: relative; /* Ważne dla pozycjonowania dzieci */
    overflow: hidden;
    cursor: pointer !important; /* Wymuszenie kursora "łapki" na całym slajdzie */
}

.dm-card-slider .swiper-slide.swiper-slide-active{
    height: var(--active-height);
}

.dm-card-slider .swiper-wrapper{
    align-items: center;
}

/* Nakładka tylko na slajdzie - dodano pointer-events: none, żeby nie blokowała kliknięć */
.dm-card-slider .swiper-slide:before{
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    background: rgb(0,0,0);
    background: linear-gradient(20deg, rgba(0,0,0,var(--overlay)) 0%, rgba(0,0,0,0) 100%);
    height: 100%;
    width: 100%;
    z-index: 1;
    pointer-events: none; 
}

.dm-card-slider .elementor-testimonial__footer{
    display: block;
}

/* KLUCZOWA POPRAWKA: Selektor obrazka uderza tylko w slajd, nie w inne elementy (np. flagi) */
.dm-card-slider .swiper-slide img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover; /* Zapobiega rozciąganiu zdjęć */
    border-radius: var(--radius);
    z-index: 0;
    transition: transform 0.4s ease-in-out; /* Płynna animacja zdjęcia */
}

/* Delikatne powiększenie zdjęcia po najechaniu myszką */
.dm-card-slider .swiper-slide:hover img {
    transform: scale(1.05);
}

.dm-card-slider .elementor-testimonial__cite{
    z-index: 2;
    position: relative;
    pointer-events: none; /* Żeby tekst nie blokował kliknięcia w link poniżej */
}

.dm-card-slider .elementor-testimonial__name{
    margin-bottom: 10px;
}

.dm-card-slider .elementor-swiper-button-prev,
.dm-card-slider .elementor-swiper-button-next{
    display: none;
}

/* Link rozciągnięty na całym slajdzie */
.dm-card-slider .slide-full-link {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    text-decoration: none !important;
}

@media (max-width: 1024px){
    .dm-card-slider{
        height: auto !important;
    }
    .dm-card-slider .swiper-slide.swiper-slide-active,
    .dm-card-slider .swiper-slide{
        height: var(--mobile-height) !important;
    }
}

@media (max-width: 767px){
    .dm-card-slider .elementor-main-swiper{
        width: 100% !important;
        max-width: 320px !important;
        margin: 0 auto;
    }
}
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // --- 1. OBSŁUGA LINKÓW (Prawdziwe tagi <a>) ---
    const slider = document.querySelector('.dm-card-slider');
    if (slider) {
        const links = [
            "https://tasmaled.com.pl/TASMY-LED",
            "https://tasmaled.com.pl/oprawy",
            "https://scharfer.com.pl/oferta",
            "https://klusdesign.pl/produkty/profile-led",
            "https://miboxer.pl/kategoria-produktu/sterowanie/",
            "https://tasmaled.com.pl/akcesoria/",
            "https://tasmaled.com.pl/silpro"
        ];

        const allSlides = slider.querySelectorAll('.swiper-slide');

        allSlides.forEach(slide => {
            let slideIndex = slide.getAttribute('data-swiper-slide-index');
            
            if (slideIndex === null) {
                slideIndex = Array.from(slide.parentNode.children).indexOf(slide);
            }

            const url = links[parseInt(slideIndex, 10)];

            if (url && !slide.querySelector('.slide-full-link')) {
                const linkElement = document.createElement('a');
                linkElement.href = url;
                linkElement.className = 'slide-full-link';
                // Zapobiegamy domyślnemu stylowaniu z motywu
                linkElement.style.border = 'none';
                linkElement.style.outline = 'none';
                slide.appendChild(linkElement);
            }
        });
    }

    // --- 2. OBSŁUGA STRZAŁEK W ELEMENTORZE ---
    if (typeof jQuery !== 'undefined') {
        (function($){
            $(document).on('click', '.dm-card-slider .card-prev', function(e){
                e.preventDefault();
                $(this).closest('.dm-card-slider').find('.elementor-swiper-button-prev').click();
            });
            
            $(document).on('click', '.dm-card-slider .card-next', function(e){
                e.preventDefault();
                $(this).closest('.dm-card-slider').find('.elementor-swiper-button-next').click();
            });
        })(jQuery);
    }
});
</script>				</div>
				</div>
				<div class="elementor-element elementor-element-2c25a3e2 elementor-widget elementor-widget-html" data-id="2c25a3e2" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<script>
document.addEventListener('keydown', function(e) {

  // nie reaguj jeśli ktoś pisze w inpucie
  const tag = document.activeElement.tagName.toLowerCase();
  if (tag === 'input' || tag === 'textarea') return;

  if (e.key === 'ArrowLeft') {
    const prev = document.querySelector('.card-prev');
    if (prev) prev.click();
  }

  if (e.key === 'ArrowRight') {
    const next = document.querySelector('.card-next');
    if (next) next.click();
  }

});
</script>				</div>
				</div>
				</div>
				</div>
					</div>
				</div>
				</div>
		]]></content:encoded>
					
